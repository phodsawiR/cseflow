{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExamFlow Knowledge Base",
  "type": "object",
  "required": ["metadata", "questions", "disease_index", "system_index", "pattern_analysis"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["generated_at", "source_files", "total_questions", "schema_version"],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "source_files": { "type": "array", "items": { "type": "string" } },
        "total_questions": { "type": "integer", "minimum": 0 },
        "total_notes": { "type": "integer", "minimum": 0 },
        "schema_version": { "type": "string" }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_file", "year", "question_number", "question_text", "choices", "diseases", "systems", "topic_type", "difficulty", "question_pattern"],
        "properties": {
          "id": { "type": "string", "pattern": "^Q\\d{4}_\\d+$" },
          "source_file": { "type": "string" },
          "year": { "type": "integer" },
          "question_number": { "type": "integer" },
          "question_text": { "type": "string" },
          "choices": { "type": "array", "items": { "type": "string" }, "minItems": 0, "maxItems": 5 },
          "answer_key": { "type": ["string", "null"], "enum": ["A", "B", "C", "D", "E", null] },
          "answer_explanation": { "type": "string" },
          "diseases": { "type": "array", "items": { "type": "string" } },
          "systems": { "type": "array", "items": { "type": "string" } },
          "topic_type": { "type": "string", "enum": ["diagnosis", "investigation", "management", "mechanism", "complication", "pharmacology", "other"] },
          "investigations_mentioned": { "type": "array", "items": { "type": "string" } },
          "management_mentioned": { "type": "array", "items": { "type": "string" } },
          "guidelines_cited": { "type": "array", "items": { "type": "string" } },
          "distractors": {
            "type": "object",
            "properties": {
              "common_wrong_answers": { "type": "array", "items": { "type": "string" } },
              "trap": { "type": "string" }
            }
          },
          "difficulty": { "type": "string", "enum": ["must_know", "high_yield", "nice_to_know", "avoid"] },
          "question_pattern": { "type": "string", "enum": ["vignette_with_labs", "image_based", "single_best", "recall", "calculation"] }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_file", "year", "note_type", "content", "diseases", "systems"],
        "properties": {
          "id": { "type": "string", "pattern": "^N\\d{4}_\\d+$" },
          "source_file": { "type": "string" },
          "year": { "type": "integer" },
          "note_number": { "type": "integer" },
          "note_type": {
            "type": "string",
            "enum": ["senior_notes", "topic_summary", "must_know_list", "prediction", "approach", "other"]
          },
          "content": { "type": "string" },
          "diseases": { "type": "array", "items": { "type": "string" } },
          "systems": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "key_points": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "disease_index": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "question_ids": { "type": "array", "items": { "type": "string" } },
          "note_ids": { "type": "array", "items": { "type": "string" } },
          "frequency": { "type": "integer" },
          "years_appeared": { "type": "array", "items": { "type": "integer" } },
          "key_investigations": { "type": "array", "items": { "type": "string" } },
          "key_management": { "type": "array", "items": { "type": "string" } },
          "must_know_facts": { "type": "array", "items": { "type": "string" } },
          "common_distractors": { "type": "array", "items": { "type": "string" } },
          "trend": { "type": "string", "enum": ["increasing", "stable", "decreasing", "new"] }
        }
      }
    },
    "system_index": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "question_ids": { "type": "array", "items": { "type": "string" } },
          "note_ids": { "type": "array", "items": { "type": "string" } },
          "diseases": { "type": "array", "items": { "type": "string" } },
          "top_topics": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "pattern_analysis": {
      "type": "object",
      "properties": {
        "most_frequent_diseases": { "type": "array", "items": { "type": "string" } },
        "topic_type_distribution": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "cross_year_trends": { "type": "array", "items": { "type": "string" } },
        "predicted_high_yield_next": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
